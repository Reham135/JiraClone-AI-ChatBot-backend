        "url": "http://host.docker.internal:5145/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"reham.ahmed@goodsmartegypt.com\",\n  \"password\": \"Reham@2021\"\n}",
        "options": {}
      },
      "id": "eb540c8d-e0a5-446c-a8cb-6f067a52633b",
