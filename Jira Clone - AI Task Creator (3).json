    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5145/api/v1/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": {{ JSON.stringify($json.output.title) }},\n  \"description\": {{ JSON.stringify($json.output.description) }},\n  \"status\": \"{{ $json.output.status }}\",\n  \"type\": \"{{ $json.output.type }}\",\n  \"priority\": \"{{ $json.output.priority }}\",\n  \"dueDate\": {{ $json.output.dueDate ? JSON.stringify($json.output.dueDate) : 'null' }},\n\"projectId\": {{ $json.projectId }},\n  \"assigneeId\": {{ $json.assigneeId || 'null' }},\n  \"sprintId\": {{ $json.sprintId || 'null' }}\n}",
        "options": {}
      },
      "id": "5fb2e5b5-e29e-48d7-9c18-bf125443580e",
      "name": "Create Task API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1072,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const createdTask = $input.item.json;\n\n// Format response for chatbot\nconst taskKey = createdTask.taskKey || `PROJ-${createdTask.id}`;\n\nreturn {\n  json: {\n    message: `✅ Task created successfully: ${taskKey} - ${createdTask.title}`,\n    taskCreated: {\n      id: createdTask.id.toString(),\n      taskKey: taskKey,\n      title: createdTask.title,\n      status: createdTask.status || 'ToDo'\n    }\n  }\n};"
      },
      "id": "732f4006-8bb6-4355-b269-4d7796b0a48e",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        128
      ]
    },
    {
