    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"minLength\": 3,\n      \"maxLength\": 300,\n      \"description\": \"Short clear title of the task\"\n    },\n    \"description\": {\n      \"type\": [\"string\", \"null\"],\n      \"maxLength\": 2000,\n      \"description\": \"Detailed description if available\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"ToDo\", \"InProgress\", \"Done\"],\n      \"description\": \"Task status\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"Low\", \"Medium\", \"High\", \"Critical\"],\n      \"description\": \"Task priority\"\n    },\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\"Task\", \"Story\", \"Bug\"],\n      \"description\": \"Task type\"\n    },\n    \"assigneeId\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Optional user ID\"\n    },\n    \"dueDate\": {\n      \"type\": [\"string\", \"null\"],\n      \"format\": \"date\",\n      \"description\": \"Due date if provided\"\n    },\n    \"tags\": {\n      \"type\": [\"string\", \"null\"],\n      \"maxLength\": 500,\n      \"description\": \"Comma separated tags\"\n    },\n    \"projectId\": {\n      \"type\": \"number\",\n      \"description\": \"Required project ID\"\n    },\n    \"sprintId\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Optional sprint ID\"\n    }\n  },\n  \"required\": [\"title\", \"status\", \"priority\", \"type\", \"projectId\"]\n}\n"
      },
