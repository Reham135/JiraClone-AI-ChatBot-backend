      "parameters": {
        "jsCode": "// Error handler\nconst error = $input.item.json.error || 'Unknown error occurred';\n\nreturn {\n  json: {\n    message: \"Sorry, I couldn't create the task. Please try again or check if the backend is running.\",\n    error: error\n  }\n};"
      },
