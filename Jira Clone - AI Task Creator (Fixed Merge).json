    {
      "parameters": {
        "jsCode": "// Error handler\nconst error = $input.item.json.error || $input.item.json.message || 'Unknown error occurred';\n\nconsole.log('Error details:', error);\n\nreturn {\n  json: {\n    message: \"Sorry, I couldn't create the task. Please try again.\",\n    error: error\n  }\n};"
      },
