    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"minLength\": 3,\n      \"maxLength\": 300,\n      \"description\": \"Short clear title of the task\"\n    },\n    \"description\": {\n      \"type\": [\"string\", \"null\"],\n      \"maxLength\": 2000,\n      \"description\": \"Detailed description if available\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"ToDo\", \"InProgress\", \"Done\"],\n      \"description\": \"Task status, default to ToDo\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"Low\", \"Medium\", \"High\", \"Critical\"],\n      \"description\": \"Task priority\"\n    },\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\"Task\", \"Story\", \"Bug\"],\n      \"description\": \"Task type\"\n    },\n    \"projectId\": {\n      \"type\": \"number\",\n      \"description\": \"Project ID, always 1\"\n    }\n  },\n  \"required\": [\"title\", \"status\", \"priority\", \"type\", \"projectId\"]\n}\n"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        80,
        400
      ],
      "id": "94b9cacb-1996-4c52-8766-ea4018950dd9",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a Jira task creation assistant. Extract task details from this message: \"{{ $json.message }}\"\n\nRules:\n- title: Clear, concise task title (required)\n- description: Detailed description, use the message content if not specific\n- status: Always \"ToDo\"\n- priority: Detect from keywords (high/urgent/critical → High, low → Low, default → Medium)\n- type: Detect from keywords (bug/fix/error → Bug, story/feature → Story, default → Task)\n- projectId: Always 1\n\nExamples:\n- \"Fix login bug\" → type: Bug, priority: High, title: \"Fix login bug\"\n- \"Create user profile feature\" → type: Story, priority: Medium, title: \"Create user profile feature\"\n- \"Update documentation\" → type: Task, priority: Medium, title: \"Update documentation\"\n\nReturn ONLY the structured JSON, no other text."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
